# =============================================================================
# JobSilver Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# =============================================================================
# ADMIN ACCESS
# Comma-separated list of admin email addresses
# These users will have access to the admin dashboard
# =============================================================================
ADMIN_EMAILS=admin@example.com

# =============================================================================
# SUPABASE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# RAPIDAPI (fantastic.jobs)
# =============================================================================
RAPIDAPI_KEY=your-rapidapi-key

# =============================================================================
# OPENAI
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key

# =============================================================================
# ADOBE PDF SERVICES (for CV parsing)
# =============================================================================
ADOBE_CLIENT_ID=your-adobe-client-id
ADOBE_CLIENT_SECRET=your-adobe-client-secret

# =============================================================================
# ENCRYPTION KEY (Legacy - auto-apply feature removed)
# =============================================================================
# 32-byte hex key for AES-256 encryption (if needed for future features)
# Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=replace-with-output-from-openssl-rand-hex-32

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# STRIPE PAYMENT INTEGRATION
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Webhook secret for verifying Stripe webhook signatures
# Get from: https://dashboard.stripe.com/webhooks
# For local testing: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Price IDs for each plan (create products in Stripe Dashboard)
# https://dashboard.stripe.com/products
# Create recurring prices for each plan with weekly and monthly billing
# Only Pro plan includes a 3-day free trial

# Starter Plan ($4.99/week, $14.99/month) - 10 jobs/day, 5 auto-apply/day
STRIPE_PRICE_STARTER_WEEKLY=price_starter_weekly_id
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_id

# Pro Plan ($9.99/week, $29.99/month) - 25 jobs/day, 15 auto-apply/day
STRIPE_PRICE_PRO_WEEKLY=price_pro_weekly_id
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id

# Ultra Plan ($19.99/week, $59.99/month) - 50 jobs/day, 30 auto-apply/day
STRIPE_PRICE_ULTRA_WEEKLY=price_ultra_weekly_id
STRIPE_PRICE_ULTRA_MONTHLY=price_ultra_monthly_id

# Legacy price IDs (optional, for backwards compatibility)
STRIPE_PRICE_BASIC=price_basic_monthly_id
STRIPE_PRICE_PRO=price_pro_monthly_id
STRIPE_PRICE_ULTRA=price_ultra_monthly_id
STRIPE_PRICE_MEGA=price_mega_monthly_id

# =============================================================================
# CRON JOBS (Vercel Cron / External Cron Services)
# =============================================================================
# Secret key to authenticate cron job requests
# CRITICAL: Generate a secure key with: openssl rand -hex 32
# Used by /api/cron/daily-curation
CRON_SECRET=replace-with-output-from-openssl-rand-hex-32

# Application URL (used by cron jobs to call internal APIs)
# Set to your production URL in deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# EMAIL NOTIFICATIONS (Resend)
# =============================================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Email sender address (must be verified domain in Resend)
# For development/testing, use: onboarding@resend.dev
EMAIL_FROM=noreply@example.com

# Optional: Reply-to address for support emails
EMAIL_REPLY_TO=support@example.com

# =============================================================================
# INTERNAL API (for server-to-server calls)
# =============================================================================
# Secret key for internal API authentication (webhook-to-API calls, curation triggers)
#
# CRITICAL SECURITY: Generate a cryptographically secure 64-character hex key!
# DO NOT use readable strings like "my-secret-key" - these are easily guessable.
#
# Generate your key with: openssl rand -hex 32
# Example output format: a1b2c3d4e5f6...  (64 hex characters)
#
# Replace the placeholder below with YOUR generated key:
INTERNAL_API_KEY=replace-with-output-from-openssl-rand-hex-32
