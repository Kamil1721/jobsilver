{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily-curation",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/cleanup-expired-jobs",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/daily-curation/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/cleanup-expired-jobs/route.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/jobs/:id",
      "destination": "/api/jobs/:id"
    },
    {
      "source": "/api/jobs/:id/chat",
      "destination": "/api/jobs/:id/chat"
    },
    {
      "source": "/api/jobs/:id/favorite",
      "destination": "/api/jobs/:id/favorite"
    }
  ]
}
